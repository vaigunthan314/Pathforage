#!/bin/sh
# Maven Wrapper script for Unix/Mac

set -e

# Find project base directory
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(cd "$(dirname "$0")" && pwd)}"
export MAVEN_PROJECTBASEDIR

# Maven wrapper jar location
WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"
WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"

# Download Maven if not present
if [ ! -e "$WRAPPER_JAR" ]; then
    if command -v wget > /dev/null; then
        DOWNLOAD_URL=$(grep distributionUrl "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)
        echo "Downloading Maven from $DOWNLOAD_URL"
        wget -q -O "$WRAPPER_JAR.tmp" "$DOWNLOAD_URL"
        mv "$WRAPPER_JAR.tmp" "$WRAPPER_JAR"
    elif command -v curl > /dev/null; then
        DOWNLOAD_URL=$(grep distributionUrl "$WRAPPER_PROPERTIES" | cut -d'=' -f2-)
        echo "Downloading Maven from $DOWNLOAD_URL"
        curl -sL -o "$WRAPPER_JAR.tmp" "$DOWNLOAD_URL"
        mv "$WRAPPER_JAR.tmp" "$WRAPPER_JAR"
    else
        echo "Error: Neither wget nor curl found. Please install Maven manually."
        exit 1
    fi
fi

# Run Maven
exec java -jar "$WRAPPER_JAR" "$@"
