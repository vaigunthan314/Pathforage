# Firebase Web App configuration (get these from your Firebase project > Project settings)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL (dev: http://localhost:8080, prod: your Render backend URL, e.g. https://<service>.onrender.com)
VITE_API_URL=
