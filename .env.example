# PathForge AI Environment Variables

# Backend
GROQ_API_KEY=your_groq_api_key_here
AI_API_KEY=your_legacy_fallback_api_key_here

# Database (for production)
DB_URL=jdbc:mysql://localhost:3306/pathforge
DB_USERNAME=root
DB_PASSWORD=your_password

# CORS (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://pathforage.onrender.com

# Frontend (set this to your deployed backend URL for production)
VITE_API_URL=http://localhost:8080
